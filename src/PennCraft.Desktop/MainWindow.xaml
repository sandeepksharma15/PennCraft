<Window x:Class="PennCraft.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PennCraft Pen" Width="600" Height="300" MinWidth="240" MinHeight="120"
        Left="100" Top="100" WindowStyle="None" ResizeMode="CanResize"
        AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" ShowActivated="False" AllowDrop="False">
    <Window.Resources>
        <Style x:Key="HeaderButton" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Width" Value="28"/>
            <Setter Property="Height" Value="26"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBody" Background="{TemplateBinding Background}" CornerRadius="3">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBody" Property="Background" Value="#33FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="Visibility" Value="Hidden"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsMouseOver, ElementName=Header}" Value="True">
                    <Setter Property="Visibility" Value="Visible"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="Thumb">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border Background="Transparent"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid>
        <Border x:Name="PenBody" CornerRadius="6" Margin="1" BorderBrush="#25FFFFFF" BorderThickness="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="32"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Border x:Name="Header" Background="Transparent" CornerRadius="6,6,0,0">
                    <Grid Margin="5,2">
                        <Thumb DragDelta="MovePen" MouseDoubleClick="EditTitle" Cursor="SizeAll"
                               ToolTip="Drag to move. Double-click to rename."/>
                        <TextBlock x:Name="TitleLabel" Text="Programs" Foreground="White" FontSize="15"
                                   FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Margin="34,0"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"/>
                        <TextBox x:Name="TitleEditor" Visibility="Collapsed" Margin="34,0" MaxLength="80"
                                 HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                                 Background="#FF202026" Foreground="White" BorderThickness="0"
                                 KeyDown="TitleEditorKeyDown" LostKeyboardFocus="TitleEditorLostFocus"/>
                        <Button Style="{StaticResource HeaderButton}" Content="☰" HorizontalAlignment="Left"
                                Click="OpenMenu" ToolTip="Pen settings" AutomationProperties.Name="Pen settings"/>
                        <Button Style="{StaticResource HeaderButton}" Content="×" HorizontalAlignment="Right"
                                Click="ClosePen" ToolTip="Hide Pen" AutomationProperties.Name="Hide Pen"/>
                    </Grid>
                </Border>
            </Grid>
        </Border>
        <!-- Explicit grips also work with a layered, transparent WPF window. -->
        <Thumb Tag="W" Width="6" HorizontalAlignment="Left" Cursor="SizeWE" DragDelta="ResizePen"/>
        <Thumb Tag="E" Width="6" HorizontalAlignment="Right" Cursor="SizeWE" DragDelta="ResizePen"/>
        <Thumb Tag="N" Height="6" VerticalAlignment="Top" Cursor="SizeNS" DragDelta="ResizePen"/>
        <Thumb Tag="S" Height="6" VerticalAlignment="Bottom" Cursor="SizeNS" DragDelta="ResizePen"/>
        <Thumb Tag="NW" Width="10" Height="10" HorizontalAlignment="Left" VerticalAlignment="Top" Cursor="SizeNWSE" DragDelta="ResizePen"/>
        <Thumb Tag="NE" Width="10" Height="10" HorizontalAlignment="Right" VerticalAlignment="Top" Cursor="SizeNESW" DragDelta="ResizePen"/>
        <Thumb Tag="SW" Width="10" Height="10" HorizontalAlignment="Left" VerticalAlignment="Bottom" Cursor="SizeNESW" DragDelta="ResizePen"/>
        <Thumb Tag="SE" Width="10" Height="10" HorizontalAlignment="Right" VerticalAlignment="Bottom" Cursor="SizeNWSE" DragDelta="ResizePen"/>
    </Grid>
</Window>
