<Window x:Class="PennCraft.Desktop.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
 Title="PennCraft Pen" Width="360" Height="240" MinWidth="240" MinHeight="160"
 Left="100" Top="100" WindowStyle="None" ResizeMode="CanResize"
 ShowInTaskbar="False" ShowActivated="False" Background="#243447" AllowDrop="False">
 <shell:WindowChrome.WindowChrome>
  <shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="8" GlassFrameThickness="0" CornerRadius="0"/>
 </shell:WindowChrome.WindowChrome>
 <Border BorderBrush="#7899B8" BorderThickness="1" Padding="8">
  <Grid>
   <Grid.RowDefinitions><RowDefinition Height="32"/><RowDefinition Height="*"/><RowDefinition Height="24"/></Grid.RowDefinitions>
   <Thumb x:Name="TitleGrip" DragDelta="MovePen" Cursor="SizeAll" Margin="0,0,40,0">
    <Thumb.Template><ControlTemplate><Border Background="#364F68"><TextBlock Text="Pen · drag here" Foreground="White" Margin="8,4"/></Border></ControlTemplate></Thumb.Template>
   </Thumb>
   <Button Content="×" Width="32" HorizontalAlignment="Right" Click="ClosePen" ToolTip="Exit PennCraft"/>
   <TextBlock Grid.Row="1" Text="Desktop integration preview&#10;&#10;Resize using any edge or corner.&#10;File drops are disabled." Foreground="White" Margin="8,14" TextWrapping="Wrap"/>
   <TextBlock Grid.Row="2" Text="Milestone 0.1 · no files managed" Foreground="#BBD0E0" FontSize="11"/>
  </Grid>
 </Border>
</Window>
