<Window x:Class="PennCraft.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:local="clr-namespace:PennCraft.Desktop"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PennCraft Pen" Width="600" Height="300" MinWidth="240" MinHeight="120"
        Left="100" Top="100" WindowStyle="None" ResizeMode="CanResize"
        AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" ShowActivated="False" AllowDrop="True"
        PreviewDragOver="PreviewItemDragOver" PreviewDrop="DropItems"
        MouseRightButtonUp="PenBackgroundRightClick" KeyDown="ItemContextKey" PreviewKeyDown="GeometryDragKeyDown">
    <Window.Resources>
        <Style x:Key="HeaderButton" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Width" Value="28"/>
            <Setter Property="Height" Value="26"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBody" Background="{TemplateBinding Background}" CornerRadius="3">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBody" Property="Background" Value="#33FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="Visibility" Value="Hidden"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsMouseOver, ElementName=Header}" Value="True">
                    <Setter Property="Visibility" Value="Visible"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="Thumb">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border Background="Transparent"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid>
        <Border x:Name="PenBody" CornerRadius="6" Margin="1" BorderBrush="#25FFFFFF" BorderThickness="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="32"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Border x:Name="Header" Background="Transparent" CornerRadius="6,6,0,0">
                    <Grid Margin="5,2">
                        <Thumb DragDelta="MovePen" DragStarted="GeometryDragStarted" DragCompleted="GeometryDragCompleted" Cursor="SizeAll"
                               ToolTip="Drag on the screen grid. Hold Alt for smooth movement."/>
                        <TextBlock x:Name="TitleLabel" Text="Programs" Foreground="White" FontSize="15"
                                   FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Margin="34,0"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" Cursor="IBeam"
                                   MouseLeftButtonDown="EditTitle" ToolTip="Click to rename"/>
                        <TextBox x:Name="TitleEditor" Visibility="Collapsed" Margin="34,0" MaxLength="80"
                                 HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                                 Background="#FF202026" Foreground="White" BorderThickness="0"
                                 KeyDown="TitleEditorKeyDown" LostKeyboardFocus="TitleEditorLostFocus"/>
                        <Button Style="{StaticResource HeaderButton}" Content="☰" HorizontalAlignment="Left"
                                Click="OpenMenu" ToolTip="Pen settings" AutomationProperties.Name="Pen settings"/>
                        <Button Style="{StaticResource HeaderButton}" Content="×" HorizontalAlignment="Right"
                                Click="ClosePen" ToolTip="Close Pen (empty Pens are deleted)" AutomationProperties.Name="Close Pen"/>
                    </Grid>
                </Border>
                <Grid Grid.Row="1" Margin="8,0,8,8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <ScrollViewer x:Name="ItemScrollViewer" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                  CanContentScroll="False">
                        <ItemsControl x:Name="ItemGrid">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Width="{x:Static local:PenLayoutMetrics.TileWidth}" Height="{x:Static local:PenLayoutMetrics.TileHeight}" Margin="{x:Static local:PenLayoutMetrics.TileMargin}" Padding="4" CornerRadius="4"
                                            ToolTip="{Binding ToolTip}"
                                            PreviewMouseLeftButtonDown="ItemMouseDown"
                                            PreviewMouseLeftButtonUp="ItemMouseUp"
                                            PreviewMouseRightButtonUp="ItemRightClick"
                                            PreviewMouseMove="ItemMouseMove"
                                            AutomationProperties.Name="{Binding DisplayName}">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="Transparent"/>
                                                <Style.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Background" Value="#25FFFFFF"/>
                                                    </Trigger>
                                                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                        <Setter Property="Background" Value="#554C78A8"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <StackPanel>
                                            <Grid Width="32" Height="32" Margin="0,1,0,6">
                                                <TextBlock Text="?" Foreground="#BBD0E0" FontSize="24"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Icon}" Value="{x:Null}">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                                <Image Source="{Binding Icon}" Width="32" Height="32"
                                                       RenderOptions.BitmapScalingMode="HighQuality"/>
                                            </Grid>
                                            <TextBlock Text="{Binding DisplayName}" Foreground="White" FontSize="11"
                                                       TextAlignment="Center" TextWrapping="Wrap"
                                                       TextTrimming="CharacterEllipsis" MaxHeight="30"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                    <TextBlock x:Name="EmptyHint" Text="Drag desktop items here to move them into the Pen" Foreground="#BBD0E0"
                               HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"/>
                    <TextBlock x:Name="ItemStatus" Grid.Row="1" Foreground="#BBD0E0" FontSize="11"
                               TextWrapping="Wrap" Margin="4,4,4,0" IsHitTestVisible="False"/>
                </Grid>
            </Grid>
        </Border>
        <!-- Explicit grips also work with a layered, transparent WPF window. -->
        <Thumb Tag="W" Width="6" HorizontalAlignment="Left" Cursor="SizeWE" DragDelta="ResizePen" DragStarted="GeometryDragStarted" DragCompleted="GeometryDragCompleted"/>
        <Thumb Tag="E" Width="6" HorizontalAlignment="Right" Cursor="SizeWE" DragDelta="ResizePen" DragStarted="GeometryDragStarted" DragCompleted="GeometryDragCompleted"/>
        <Thumb Tag="N" Height="6" VerticalAlignment="Top" Cursor="SizeNS" DragDelta="ResizePen" DragStarted="GeometryDragStarted" DragCompleted="GeometryDragCompleted"/>
        <Thumb Tag="S" Height="6" VerticalAlignment="Bottom" Cursor="SizeNS" DragDelta="ResizePen" DragStarted="GeometryDragStarted" DragCompleted="GeometryDragCompleted"/>
        <Thumb Tag="NW" Width="10" Height="10" HorizontalAlignment="Left" VerticalAlignment="Top" Cursor="SizeNWSE" DragDelta="ResizePen" DragStarted="GeometryDragStarted" DragCompleted="GeometryDragCompleted"/>
        <Thumb Tag="NE" Width="10" Height="10" HorizontalAlignment="Right" VerticalAlignment="Top" Cursor="SizeNESW" DragDelta="ResizePen" DragStarted="GeometryDragStarted" DragCompleted="GeometryDragCompleted"/>
        <Thumb Tag="SW" Width="10" Height="10" HorizontalAlignment="Left" VerticalAlignment="Bottom" Cursor="SizeNESW" DragDelta="ResizePen" DragStarted="GeometryDragStarted" DragCompleted="GeometryDragCompleted"/>
        <Thumb Tag="SE" Width="10" Height="10" HorizontalAlignment="Right" VerticalAlignment="Bottom" Cursor="SizeNWSE" DragDelta="ResizePen" DragStarted="GeometryDragStarted" DragCompleted="GeometryDragCompleted"/>
    </Grid>
</Window>
